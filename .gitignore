# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ─── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Django ───────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-journal.*
db_backups/
db_work/
media/

# ─── Environment variables — NEVER commit secrets ─────────────────────────────
.env

# ─── Static files (collected by collectstatic) ────────────────────────────────
staticfiles/

# ─── Local data caches ────────────────────────────────────────────────────────
# PE/PB/DivYield SQLite cache (auto-populated at runtime)
.cache/
*.cache.db

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
notebooks/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Distribution / packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── MyPy ─────────────────────────────────────────────────────────────────────
.mypy_cache/

# ─── Temporary / scratch files ────────────────────────────────────────────────
*.bak
*.tmp
*.orig

# Scratch / debug scripts at repo root (never commit these)
try*.py
fix_*.py
debug_*.py
scratch_*.py
*.pdf
FundReport_*.pdf

# PE/PB data cache (auto-populated, not needed in source control)
apps/portfolio/services/.pe_cache.db

