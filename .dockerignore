# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — MutualFundAnalysis
# Excludes files/directories from the Docker build context.
# Keeps the image lean and prevents secrets from leaking into layers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Secrets — NEVER bake into an image ───────────────────────────────────────
.env

# ── Local SQLite database (large, not needed in image) ────────────────────────
db.sqlite3
db.sqlite3-journal
db.sqlite3-journal.*
*.cache.db
db_backups/
db_work/

# ── Django collected static files (generated by collectstatic) ────────────────
staticfiles/

# ── User-uploaded media (managed outside container in prod) ──────────────────
media/

# ── Playwright browser cache (downloaded fresh during build) ─────────────────
# Uncomment if you pre-bake Chromium into the image (we do — see Dockerfile)
# .cache/

# ── Local data caches ─────────────────────────────────────────────────────────
.cache/
apps/portfolio/services/.pe_cache.db

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
notebooks/
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Git history ───────────────────────────────────────────────────────────────
.git/
.gitattributes
.gitignore

# ── IDE / OS artifacts ────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── Test / CI artifacts ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── Documentation / Resources (not needed at runtime) ────────────────────────
Resources/
documentation/
images/

# ── Temporary/scratch files ───────────────────────────────────────────────────
*.bak
*.tmp
*.orig
try*.py
fix_*.py
debug_*.py
scratch_*.py

# ── PDF reports (generated at runtime, not source) ────────────────────────────
*.pdf
FundReport_*.pdf
