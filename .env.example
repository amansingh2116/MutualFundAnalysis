SECRET_KEY=django-insecure-change-me-in-production-use-long-random-string
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1

# Risk-free rate used in Sharpe/Sortino calculations (update quarterly)
RF_ANNUAL_RATE=0.065

# Optional: AI summary layer (Phase 5)
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Dev uses console backend (set in dev.py) — these vars are only needed in prod.
# Option A — Gmail App Password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_HOST_USER=yourname@gmail.com
#   EMAIL_HOST_PASSWORD=<16-char App Password from Google Account>
# Option B — SMTP Provider (e.g., Sender.net, Postmark):
#   EMAIL_HOST=<provider-smtp-host>
#   EMAIL_HOST_USER=<provider-username>
#   EMAIL_HOST_PASSWORD=<provider-password>
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_username
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Your personal inbox where contact form messages will be delivered:
CONTACT_RECIPIENT_EMAIL=yourname@gmail.com

# Production overrides (uncomment and fill when deploying)
# DEBUG=False
# DATABASE_URL=postgres://user:password@host:5432/mfanalysis
# REDIS_URL=redis://localhost:6379/0
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

